# Machine-local state, regenerated on first run
.reader-token
# pre-2.0 name, may still exist on older installs
.mdview-token
preferences.json

# Local Claude Code settings
.claude/settings.local.json
.claude/

# Local Playwright inspection artifacts
.playwright-cli/
node_modules/
test-results/
playwright-report/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Native app output. The bundle is built by ./macos/build-app.sh locally and by
# CI for releases; it is not committed (actool regenerates Assets.car
# nondeterministically and the signature changes on every build).
/build/
/install/*
!/install/
!/install/Reader.command
.reader-build.*/

# Release workflow output: built by write-release-manifest.sh, one per tag,
# uploaded to the GitHub Release rather than committed.
/Reader-*.zip
/manifest.json
