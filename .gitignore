# Machine-local state, regenerated on first run
.reader-token
# pre-2.0 name, may still exist on older installs
.mdview-token
preferences.json

# Local Claude Code settings
.claude/settings.local.json
.claude/

# Local Playwright inspection artifacts
.playwright-cli/

# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Regenerated native app output
/build/
/install/*
!/install/
!/install/Reader.command
# The built app is committed so it can be run without a build step. Note that
# actool regenerates Assets.car (~3 MB) nondeterministically and the ad-hoc
# signature changes on every build, so each rebuild you commit adds that much
# again to history rather than diffing against the last one.
!/install/Reader.app
install/Reader.app/Contents/_CodeSignature/
